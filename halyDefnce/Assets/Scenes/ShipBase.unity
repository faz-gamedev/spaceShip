  originalText: "\xAB\u0648\u0627\u0631\u062A\u0627\u06CC\u062A\u0627\u0646\xBB \u06CC\u06A9
    \u0633\u0641\u06CC\u0646\u0647 \u062C\u0646\u06AF\u06CC \u062A\u0645\u0627\u0645\u200C\u0639\u06CC\u0627\u0631
