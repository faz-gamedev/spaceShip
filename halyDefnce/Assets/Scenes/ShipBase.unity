  originalText: "\xAB\u0628\u0644\u06A9\u200C\u0634\u06CC\u0644\u062F\xBB \u06CC\u06A9
    \u0633\u0641\u06CC\u0646\u0647 \u0628\u0627\u0631\u06CC \u0642\u062F\u0631\u062A\u0645\u0646\u062F
    \u0648 \u0645\u0642\u0627\u0648\u0645 \u0627\u0633\u062A \u06A9\u0647 \u0628\u0631\u0627\u06CC
    \u062D\u0645\u0644 \u0645\u062D\u0645\u0648\u0644\u0647\u200C\u0647\u0627\u06CC
    \u0633\u0646\u06AF\u06CC\u0646 \u0637\u0631\u0627\u062D\u06CC \u0634\u062F\u0647.
    \u0633\u0631\u0639\u062A\u0634 \u0632\u06CC\u0627\u062F \u0646\u06CC\u0633\u062A
    \u0627\u0645\u0627 \u0628\u062F\u0646\u0647\u200C\u0627\u06CC \u0645\u062D\u06A9\u0645
    \u0648 \u0633\u067E\u0631\u06CC \u0642\u0648\u06CC \u062F\u0627\u0631\u062F \u06A9\u0647
    \u0622\u0646 \u0631\u0627 \u062F\u0631 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC
    \u062E\u0637\u0631\u0646\u0627\u06A9 \u0648 \u0646\u0628\u0631\u062F\u0647\u0627\u06CC
    \u0637\u0648\u0644\u0627\u0646\u06CC \u06A9\u0627\u0645\u0644\u0627\u064B \u0642\u0627\u0628\u0644\u200C\u0627\u0639\u062A\u0645\u0627\u062F
    \u0645\u06CC\u200C\u06A9\u0646\u062F.\xBB"
