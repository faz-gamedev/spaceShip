  originalText: "\xAB\u0627\u06CC\u0646 \u0645\u0646\u0637\u0642\u0647 \u0645\u062D\u0644
    \u0628\u0631\u062E\u0648\u0631\u062F\u0647\u0627\u06CC \u0633\u0647\u0645\u06AF\u06CC\u0646
