  m_text: "\xBB\uFE8D\uFBFE\uFEE6 \uFE8D\uFBFE\uFEB4\uFE98\uFB95\uFE8E\uFEE9 \uFED3\uFEC0\uFE8E\uFBFE\uFBFD
