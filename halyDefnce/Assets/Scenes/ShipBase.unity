  originalText: "\xAB\u0646\u0648\u0648\u0627\u06A9\u0648\u0631\xBB \u06CC\u06A9
    \u0633\u0641\u06CC\u0646\u0647 \u0633\u0628\u06A9 \u0648 \u0641\u0648\u0642\u200C\u0686\u0627\u0628\u06A9
    \u0627\u0633\u062A \u06A9\u0647 \u0628\u0631\u0627\u06CC \u0633\u0631\u0639\u062A
    \u0648 \u0645\u0627\u0646\u0648\u0631\u0647\u0627\u06CC \u062F\u0642\u06CC\u0642
    \u0637\u0631\u0627\u062D\u06CC \u0634\u062F\u0647. \u0627\u06CC\u0646 \u0633\u0641\u06CC\u0646\u0647
    \u0628\u0627 \u0648\u0627\u06A9\u0646\u0634\u200C\u067E\u0630\u06CC\u0631\u06CC
    \u0628\u0627\u0644\u0627 \u0648 \u0634\u062A\u0627\u0628 \u0644\u062D\u0638\u0647\u200C\u0627\u06CC
    \u0645\u0646\u0627\u0633\u0628 \u062E\u0644\u0628\u0627\u0646\u0627\u0646\u06CC
    \u0627\u0633\u062A \u06A9\u0647 \u0645\u06CC\u200C\u062E\u0648\u0627\u0647\u0646\u062F
    \u062F\u0631 \u0646\u0628\u0631\u062F\u0647\u0627\u06CC \u0633\u0631\u06CC\u0639
    \u0648 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC \u067E\u06CC\u0686\u06CC\u062F\u0647
    \u067E\u06CC\u0634\u062A\u0627\u0632 \u0628\u0627\u0634\u0646\u062F.\xBB"
