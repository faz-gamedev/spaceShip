  originalText: "\xAB\u0627\u06CC\u0646 \u0627\u06CC\u0633\u062A\u06AF\u0627\u0647
    \u0641\u0636\u0627\u06CC\u06CC \u0645\u062A\u0631\u0648\u06A9\u0647 \u0628\u0627
    \u0633\u0627\u0632\u0647\u200C\u0647\u0627\u06CC \u0639\u062C\u06CC\u0628 \u0648
    \u0645\u0639\u0645\u0627\u0631\u06CC \u0646\u0627\u0645\u062A\u0639\u0627\u0631\u0641\u0634
    \u0641\u0636\u0627\u06CC\u06CC \u0645\u0631\u0645\u0648\u0632 \u0648 \u067E\u0631
    \u0631\u0645\u0632 \u0648 \u0631\u0627\u0632 \u0627\u06CC\u062C\u0627\u062F \u06A9\u0631\u062F\u0647
    \u0627\u0633\u062A. \u0631\u0627\u0647\u0631\u0648\u0647\u0627\u06CC \u067E\u06CC\u0686\u06CC\u062F\u0647
    \u0648 \u062A\u062C\u0647\u06CC\u0632\u0627\u062A \u0646\u0627\u0634\u0646\u0627\u062E\u062A\u0647
    \u0622\u0646 \u0631\u0627 \u0628\u0647 \u0645\u06A9\u0627\u0646\u06CC \u062E\u0637\u0631\u0646\u0627\u06A9
    \u0627\u0645\u0627 \u0648\u0633\u0648\u0633\u0647\u200C\u0627\u0646\u06AF\u06CC\u0632
    \u0628\u0631\u0627\u06CC \u06A9\u0627\u0648\u0634 \u062A\u0628\u062F\u06CC\u0644
    \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F\xBB"
