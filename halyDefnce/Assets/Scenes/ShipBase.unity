  m_text: "\xBB\uFE8D\uFBFE\uFEE6 \uFEE3\uFEE8\uFEC4\uFED8\uFEEA \uFEE3\uFEA4\uFEDE
    \uFE91\uFEAE\uFEA7\uFEEE\uFEAD\uFEA9\uFEEB\uFE8E\uFBFC \uFEB3\uFEEC\uFEE4\uFB95\uFBFF\uFEE6
    \uFEA9\uFEAD \uFBFE\uFB8F \uFE9F\uFEE8\uFB93 \uFEE3\uFBFF\uFE8E\uFEE5\uFEB3\uFE98\uFE8E\uFEAD\uFEE9\uFE8D\uFBFC
