  m_EditorClassIdentifier: Assembly-CSharp::TypewriterEffect
  rtlText: {fileID: 7292544582525808048}
  fullText: 
  typingSpeed: 0.05
  textTemplate: "\u0647\u06CC\u0686\u200C\u0648\u0642\u062A \u0628\u0627 \u0633\u0641\u06CC\u0646\u0647\u200C\u0647\u0627\u06CC
    \u0627\u0645\u067E\u0631\u0627\u062A\u0648\u0631\u06CC \u062F\u0631\u06AF\u06CC\u0631
    \u0646\u0634\u0648\u2026 \u0622\u0646\u200C\u0647\u0627 \u0628\u0631\u0627\u06CC
    \u062C\u0646\u06AF \u0633\u0627\u062E\u062A\u0647 \u0634\u062F\u0647\u200C\u0627\u0646\u062F
    \u0648 \u0631\u0648\u06CC\u0627\u0631\u0648\u06CC\u06CC \u0628\u0627 \u0622\u0646\u200C\u0647\u0627
    \u0641\u0642\u0637 \u06CC\u06A9 \u067E\u0627\u06CC\u0627\u0646 \u062F\u0627\u0631\u062F:
    \u0646\u0627\u0628\u0648\u062F\u06CC."
  typingSound: {fileID: 8300000, guid: 9a457419641dd0a4e8b6c130803fb97a, type: 3}
