  originalText: "\u0647\u0631 \u0628\u0627\u0631 \u0627\u0633\u062A\u0641\u0627\u062F\u0647
    \u0627\u0632 \u062A\u0644\u0647\u200C\u067E\u0648\u0631\u062A \u06CC\u0639\u0646\u06CC
