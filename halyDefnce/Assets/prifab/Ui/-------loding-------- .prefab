  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TypewriterEffect
  rtlText: {fileID: 0}
  fullText: 
  typingSpeed: 0.05
  textTemplate: "\u0647\u0631 \u0628\u0627\u0631 \u0627\u0633\u062A\u0641\u0627\u062F\u0647
    \u0627\u0632 \u062A\u0644\u0647\u200C\u067E\u0648\u0631\u062A \u06CC\u0639\u0646\u06CC
    \u0648\u0631\u0648\u062F \u0628\u0647 \u0641\u0636\u0627\u06CC\u06CC \u062A\u0627\u0632\u0647
    \u0648 \u062E\u0637\u0631\u0646\u0627\u06A9\u061B \u0622\u0645\u0627\u062F\u0647
    \u0628\u0627\u0634 \u0645\u0642\u0635\u062F \u0647\u0645\u06CC\u0634\u0647 \u0642\u0627\u0628\u0644
    \u067E\u06CC\u0634\u200C\u0628\u06CC\u0646\u06CC \u0646\u06CC\u0633\u062A  \u0647\u06CC\u0686\u200C\u06A9\u0633
    \u0646\u0645\u06CC\u200C\u062F\u0627\u0646\u062F \u0628\u0639\u062F \u0627\u0632
    \u062A\u0644\u0647\u200C\u067E\u0648\u0631\u062A \u0686\u0647 \u0628\u062E\u0634\u06CC
    \u0627\u0632 \u062A\u0648 \u0648\u0627\u0642\u0639\u0627\u064B \u0645\u0646\u062A\u0642\u0644
    \u0645\u06CC\u200C\u0634\u0648\u062F\u2026 \u0648 \u0686\u0647 \u0628\u062E\u0634\u06CC
    \u067E\u0634\u062A \u0633\u0631 \u062C\u0627 \u0645\u06CC\u200C\u0645\u0627\u0646\u062F"
  typingSound: {fileID: 8300000, guid: 9a457419641dd0a4e8b6c130803fb97a, type: 3}
