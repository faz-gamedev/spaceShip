  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TypewriterEffect
  rtlText: {fileID: 1684641502742119784}
  fullText: 
  typingSpeed: 0.05
  textTemplate: "\u0645\u06CC\u0627\u0646 \u062A\u0627\u0631\u06CC\u06A9\u06CC \u0641\u0636\u0627
    \u0633\u0627\u0632\u0647\u200C\u0647\u0627\u06CC\u06CC \u063A\u0648\u0644\u200C\u0622\u0633\u0627
    \u0648 \u0639\u062C\u06CC\u0628 \u067E\u0646\u0647\u0627\u0646 \u0634\u062F\u0647\u200C\u0627\u0646\u062F\u061B
    \u0646\u0632\u062F\u06CC\u06A9\u200C\u0634\u062F\u0646 \u0628\u0647 \u0628\u0639\u0636\u06CC
    \u0627\u0632 \u0622\u0646\u200C\u0647\u0627 \u06CC\u0639\u0646\u06CC \u062F\u0639\u0648\u062A\u200C\u0646\u0627\u0645\u0647\u200C\u0627\u06CC
    \u0628\u0631\u0627\u06CC \u0646\u0627\u0628\u0648\u062F\u06CC \u0627\u0633\u062A"
  typingSound: {fileID: 8300000, guid: 9a457419641dd0a4e8b6c130803fb97a, type: 3}
  audioSource: {fileID: 392642331578818451}
